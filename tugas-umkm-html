<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lumpia Crispy Premium</title>

    <!-- Bootstrap 5 -->
    <link 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
        rel="stylesheet">

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #fffaf5;
        }

        .hero {
            background: linear-gradient(135deg, #fff0dc, #ffe0b2);
            padding: 80px 0;
        }

        .hero h1 {
            font-weight: bold;
            color: #8b4513;
        }

        .section-title {
            color: #8b4513;
            font-weight: bold;
        }

        .product-card {
            transition: 0.3s;
        }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-img {
            height: 200px;
            object-fit: cover;
        }

        footer {
            background-color: #8b4513;
            color: white;
        }

        /* RESPONSIVE BREAKPOINT 1 - Tablet */
        @media (max-width: 991px) {
            .hero {
                padding: 60px 0;
            }

            .hero h1 {
                font-size: 38px;
            }
        }

        /* RESPONSIVE BREAKPOINT 2 - HP */
        @media (max-width: 767px) {
            .hero {
                text-align: center;
                padding: 45px 0;
            }

            .hero h1 {
                font-size: 30px;
            }

            .hero p {
                font-size: 14px;
            }

            .product-img {
                height: 180px;
            }
        }

        /* RESPONSIVE BREAKPOINT 3 - HP kecil */
        @media (max-width: 575px) {
            .hero h1 {
                font-size: 26px;
            }

            .hero {
                padding: 35px 15px;
            }

            .product-img {
                height: 160px;
            }

            .section-title {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg navbar-dark" style="background-color:#8b4513;">
    <div class="container">

        <a class="navbar-brand fw-bold" href="#">
            🥟 Lumpia Crispy
        </a>

        <button 
            class="navbar-toggler" 
            type="button" 
            data-bs-toggle="collapse" 
            data-bs-target="#navbarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMenu">
            <ul class="navbar-nav ms-auto">

                <li class="nav-item">
                    <a class="nav-link active" href="#home">Home</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#produk">Produk</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#tentang">Tentang</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#pesan">Pesan</a>
                </li>

            </ul>
        </div>
    </div>
</nav>


<!-- ================= HERO ================= -->
<section class="hero" id="home">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <span class="badge text-bg-warning mb-3">
                    UMKM Kuliner
                </span>

                <h1>
                    Lumpia Crispy Premium
                </h1>

                <p class="lead">
                    Lumpia renyah dengan isian lezat dan dibuat
                    menggunakan bahan berkualitas.
                </p>

                <a href="#produk" class="btn btn-dark btn-lg">
                    Lihat Produk
                </a>
            </div>

            <div class="col-lg-6 text-center mt-4 mt-lg-0">
                <img 
                    src="https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=800&q=80"
                    class="img-fluid rounded-4 shadow"
                    alt="Lumpia">
            </div>

        </div>
    </div>
</section>


<!-- ================= CAROUSEL ================= -->
<section class="container my-5">

    <h2 class="text-center section-title mb-4">
        Kenapa Pilih Kami?
    </h2>

    <div id="promoCarousel" class="carousel slide" data-bs-ride="carousel">

        <div class="carousel-indicators">
            <button type="button" data-bs-target="#promoCarousel"
                data-bs-slide-to="0" class="active"></button>

            <button type="button" data-bs-target="#promoCarousel"
                data-bs-slide-to="1"></button>

            <button type="button" data-bs-target="#promoCarousel"
                data-bs-slide-to="2"></button>
        </div>

        <div class="carousel-inner rounded-4">

            <div class="carousel-item active">
                <img 
                    src="https://images.unsplash.com/photo-1625398407796-82650a8c5b5c?auto=format&fit=crop&w=1000&q=80"
                    class="d-block w-100"
                    style="height:350px; object-fit:cover;"
                    alt="Produk">
            </div>

            <div class="carousel-item">
                <img 
                    src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1000&q=80"
                    class="d-block w-100"
                    style="height:350px; object-fit:cover;"
                    alt="Makanan">
            </div>

            <div class="carousel-item">
                <img 
                    src="https://images.unsplash.com/photo-1515003197210-e0cd71810b5f?auto=format&fit=crop&w=1000&q=80"
                    class="d-block w-100"
                    style="height:350px; object-fit:cover;"
                    alt="Kuliner">
            </div>

        </div>

        <button class="carousel-control-prev" type="button"
            data-bs-target="#promoCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button"
            data-bs-target="#promoCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>

    </div>
</section>


<!-- ================= PRODUK ================= -->
<section class="container my-5" id="produk">

    <h2 class="text-center section-title mb-4">
        Produk Kami
    </h2>

    <div class="row g-4">

        <!-- CARD 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="card product-card h-100 shadow-sm">

                <img 
                    src="https://images.unsplash.com/photo-1601050690117-94f5f6fa8bd7?auto=format&fit=crop&w=600&q=80"
                    class="card-img-top product-img"
                    alt="Lumpia Ayam">

                <div class="card-body">

                    <span class="badge text-bg-success">
                        Best Seller
                    </span>

                    <h5 class="card-title mt-2">
                        Lumpia Ayam
                    </h5>

                    <p class="card-text">
                        Lumpia dengan isian ayam gurih dan sayuran segar.
                    </p>

                    <h5 class="text-danger">
                        Rp15.000
                    </h5>

                    <button 
                        class="btn btn-outline-dark w-100"
                        data-bs-toggle="modal"
                        data-bs-target="#detailModal">
                        Detail Produk
                    </button>

                </div>
            </div>
        </div>


        <!-- CARD 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="card product-card h-100 shadow-sm">

                <img 
                    src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=600&q=80"
                    class="card-img-top product-img"
                    alt="Lumpia Sayur">

                <div class="card-body">

                    <span class="badge text-bg-primary">
                        Favorit
                    </span>

                    <h5 class="card-title mt-2">
                        Lumpia Sayur
                    </h5>

                    <p class="card-text">
                        Lumpia renyah dengan isian sayuran pilihan.
                    </p>

                    <h5 class="text-danger">
                        Rp12.000
                    </h5>

                    <button 
                        class="btn btn-outline-dark w-100"
                        data-bs-toggle="modal"
                        data-bs-target="#detailModal">
                        Detail Produk
                    </button>

                </div>
            </div>
        </div>


        <!-- CARD 3 -->
        <div class="col-md-6 col-lg-4">
            <div class="card product-card h-100 shadow-sm">

                <img 
                    src="https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=600&q=80"
                    class="card-img-top product-img"
                    alt="Lumpia Premium">

                <div class="card-body">

                    <span class="badge text-bg-warning">
                        Premium
                    </span>

                    <h5 class="card-title mt-2">
                        Lumpia Premium
                    </h5>

                    <p class="card-text">
                        Lumpia spesial dengan isian premium dan saus khas.
                    </p>

                    <h5 class="text-danger">
                        Rp20.000
                    </h5>

                    <button 
                        class="btn btn-outline-dark w-100"
                        data-bs-toggle="modal"
                        data-bs-target="#detailModal">
                        Detail Produk
                    </button>

                </div>
            </div>
        </div>

    </div>
</section>


<!-- ================= TENTANG ================= -->
<section class="container my-5" id="tentang">

    <div class="row align-items-center">

        <div class="col-md-6">
            <h2 class="section-title">
                Tentang Lumpia Crispy
            </h2>

            <p>
                Lumpia Crispy Premium adalah UMKM yang menyediakan
                makanan ringan dengan rasa lezat, harga terjangkau,
                dan kualitas bahan yang baik.
            </p>

            <div class="alert alert-warning">
                <strong>Info:</strong> Bisa menerima pesanan untuk acara,
                rapat, ulang tahun, dan berbagai kegiatan lainnya.
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center">

                    <h4>Keunggulan Kami</h4>

                    <p>✅ Bahan berkualitas</p>
                    <p>✅ Dibuat fresh</p>
                    <p>✅ Harga terjangkau</p>
                    <p>✅ Bisa pesan dalam jumlah banyak</p>

                </div>
            </div>
        </div>

    </div>
</section>


<!-- ================= FORM PEMESANAN ================= -->
<section class="container my-5" id="pesan">

    <h2 class="text-center section-title mb-4">
        Form Pemesanan
    </h2>

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form id="orderForm" class="needs-validation" novalidate>

                        <!-- Nama -->
                        <div class="mb-3">
                            <label class="form-label">
                                Nama Lengkap
                            </label>

                            <input 
                                type="text"
                                class="form-control"
                                id="nama"
                                required>

                            <div class="invalid-feedback">
                                Nama wajib diisi.
                            </div>
                        </div>


                        <!-- Nomor HP -->
                        <div class="mb-3">
                            <label class="form-label">
                                Nomor WhatsApp
                            </label>

                            <input 
                                type="tel"
                                class="form-control"
                                id="nomor"
                                required>

                            <div class="invalid-feedback">
                                Nomor WhatsApp wajib diisi.
                            </div>
                        </div>


                        <!-- Produk -->
                        <div class="mb-3">

                            <label class="form-label">
                                Pilih Produk
                            </label>

                            <select class="form-select" id="produkPilihan" required>

                                <option value="">
                                    -- Pilih Produk --
                                </option>

                                <option>
                                    Lumpia Ayam - Rp15.000
                                </option>

                                <option>
                                    Lumpia Sayur - Rp12.000
                                </option>

                                <option>
                                    Lumpia Premium - Rp20.000
                                </option>

                            </select>

                            <div class="invalid-feedback">
                                Silakan pilih produk.
                            </div>

                        </div>


                        <!-- Jumlah -->
                        <div class="mb-3">

                            <label class="form-label">
                                Jumlah
                            </label>

                            <input 
                                type="number"
                                class="form-control"
                                id="jumlah"
                                min="1"
                                required>

                            <div class="invalid-feedback">
                                Jumlah minimal 1.
                            </div>

                        </div>


                        <!-- Alamat -->
                        <div class="mb-3">

                            <label class="form-label">
                                Alamat
                            </label>

                            <textarea 
                                class="form-control"
                                id="alamat"
                                rows="3"
                                required></textarea>

                            <div class="invalid-feedback">
                                Alamat wajib diisi.
                            </div>

                        </div>


                        <button 
                            type="submit"
                            class="btn btn-dark w-100">
                            Kirim Pesanan
                        </button>

                    </form>

                </div>
            </